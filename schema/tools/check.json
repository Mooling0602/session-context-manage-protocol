{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Mooling0602/session-context-manage-protocol/main/schema/tools/check.json",
  "title": "SCMP tool: check (input)",
  "description": "检查目标会话状态与最近上下文（兜底获取结果；非主路径，主路径为自动回送）（docs/10-tools.md §4）",
  "type": "object",
  "required": ["target"],
  "properties": {
    "target": { "type": "string", "minLength": 1, "description": "目标会话的 sessionId" },
    "limit": { "type": "integer", "minimum": 1, "maximum": 50, "default": 10, "description": "返回最近 N 条消息" }
  },
  "additionalProperties": false
}
